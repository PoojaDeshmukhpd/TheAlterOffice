<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Queue screen heading -->
    <TextView
        android:id="@+id/tvQueueTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Event Queue (Click on Plus Button To see results)"
        android:textColor="#343746"
        android:textSize="12sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnRefresh" />

    <!-- Refresh action -->
    <TextView
        android:id="@+id/btnRefresh"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="↻"
        android:visibility="visible"
        android:textColor="#687184"
        android:textSize="18sp"
        android:contentDescription="Refresh event queue"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="@id/tvQueueTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvQueueTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status filters -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/queueTabs"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorColor="#5145FF"
        app:tabIndicatorHeight="2dp"
        app:tabSelectedTextColor="#5145FF"
        app:tabTextColor="#687184"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Caption"
        app:layout_constraintTop_toBottomOf="@id/tvQueueTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Event list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/queueTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Submission input is retained for the assignment's JSON input flow.
         It is placed below the list in a later step if needed. -->


    <TextView
        android:id="@+id/btnAddEvent"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="Add event"
        android:focusable="true"
        android:gravity="center"
        android:text="+"
        android:textColor="#2563EB"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnRefresh"
        app:layout_constraintTop_toTopOf="@id/btnRefresh"
        app:layout_constraintBottom_toBottomOf="@id/btnRefresh" />

</androidx.constraintlayout.widget.ConstraintLayout>
